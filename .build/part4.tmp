<script>
// navbar transparent -> solid
const header = document.getElementById('header');
const heroImg = document.getElementById('heroImg');
const nightImg = document.getElementById('nightImg');
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

function onScroll(){
  header.classList.toggle('scrolled', scrollY > 40);
  if (reduce) return;
  // hero parallax
  if (scrollY < innerHeight * 1.2){
    heroImg.style.transform = 'translateY(' + scrollY * 0.26 + 'px)';
  }
  // night image parallax
  const r = nightImg.parentElement.getBoundingClientRect();
  if (r.bottom > 0 && r.top < innerHeight){
    const off = (r.top + r.height/2 - innerHeight/2) * -0.07;
    nightImg.style.transform = 'scale(1.12) translateY(' + off + 'px)';
  }
}
addEventListener('scroll', onScroll, {passive:true});
onScroll();

// rotating seal text (char-by-char circular layout)
(function(){
  const rc = document.querySelector('.ring-chars');
  if (!rc) return;
  const txt = 'ATHR · LAND & SEA · OFFLINE · NO SIGNAL · NO WAY LOST · ';
  const step = 360 / txt.length;
  [...txt].forEach((ch, i) => {
    const s = document.createElement('span');
    s.textContent = ch;
    s.style.transform = 'rotate(' + (i * step) + 'deg) translate(-1.5px,-67px)';
    rc.appendChild(s);
  });
})();

// gentle reveal
const io = new IntersectionObserver(es => {
  es.forEach(e => { if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
}, {threshold:.14});
document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));
</script>
</body>
</html>