<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>أثر · ATHR — دليلك في البرّ والبحر</title>
<meta name="description" content="تصور تصميم بديل لموقع تطبيق أثر — ملاحة برّية وبحرية بلا شبكة.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600&family=Marcellus&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0d1826;
  --bg-2:#162638;
  --gold:#af915f;
  --gold-bright:#c9ab74;
  --cream:#fce1b6;
  --text:#f5f0e6;
  --muted:rgba(245,240,230,.62);
  --faint:rgba(245,240,230,.38);
  --hair:rgba(175,145,95,.32);
  --hair-soft:rgba(175,145,95,.18);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'IBM Plex Sans Arabic',system-ui,sans-serif;
  font-weight:300;
  font-size:17px;
  line-height:1.9;
  overflow-x:hidden;
}
::selection{background:var(--gold);color:var(--bg)}
::-webkit-scrollbar{width:10px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:#2a3d54;border-radius:0}
::-webkit-scrollbar-thumb:hover{background:var(--gold)}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
.display{font-family:'Amiri',serif}
.latin{font-family:'Marcellus',serif}
.mono{font-family:'IBM Plex Mono',monospace}
.wrap{max-width:1360px;margin-inline:auto;padding-inline:clamp(20px,4.5vw,64px)}

/* ---------- labels ---------- */
.eyebrow{
  display:flex;align-items:center;gap:18px;
  font-family:'IBM Plex Mono',monospace;
  font-size:11px;letter-spacing:.32em;
  color:var(--gold);text-transform:uppercase;
  margin-bottom:26px;
}
.eyebrow::before{content:'';width:54px;height:1px;background:var(--gold)}
.eyebrow .ar{font-family:'IBM Plex Sans Arabic',sans-serif;letter-spacing:.12em;font-size:13px}

/* ---------- buttons (chamfered) ---------- */
.btn{
  --cut:12px;
  display:inline-flex;align-items:center;gap:12px;
  clip-path:polygon(var(--cut) 0,100% 0,100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,0 100%,0 var(--cut));
  background:var(--gold);color:#101c2a;
  font-family:'IBM Plex Sans Arabic',sans-serif;font-weight:500;font-size:15px;
  padding:15px 30px;line-height:1.4;
  transition:background .25s ease,color .25s ease;
}
.btn svg{width:17px;height:17px;flex:none}
.btn:hover{background:var(--cream)}
.btn-ghost{
  background:var(--gold);color:var(--text);padding:1px;
}
.btn-ghost .btn-in{
  display:inline-flex;align-items:center;gap:12px;width:100%;
  background:var(--bg);padding:14px 29px;
  clip-path:polygon(calc(var(--cut) - 1px) 0,100% 0,100% calc(100% - var(--cut) + 1px),calc(100% - var(--cut) + 1px) 100%,0 100%,0 calc(var(--cut) - 1px));
  transition:background .25s ease,color .25s ease;
}
.btn-ghost:hover .btn-in{background:var(--gold);color:#101c2a}
.btn-sm{padding:10px 22px;font-size:13px}
.btn-sm.btn-ghost .btn-in{padding:9px 21px}

/* ---------- header ---------- */
header{
  position:fixed;inset-inline:0;top:0;z-index:60;
  transition:background .35s ease,border-color .35s ease,backdrop-filter .35s ease;
  border-bottom:1px solid transparent;
}
header.scrolled{
  background:rgba(13,24,38,.86);
  backdrop-filter:blur(14px);
  border-bottom-color:var(--hair-soft);
}
.nav{
  display:flex;align-items:center;justify-content:space-between;
  height:78px;
}
.brand{display:flex;align-items:baseline;gap:12px}
.brand .ar{font-family:'Amiri',serif;font-weight:700;font-size:30px;line-height:1}
.brand .en{font-family:'Marcellus',serif;font-size:12px;letter-spacing:.42em;color:var(--gold)}
.nav-links{display:flex;align-items:center;gap:36px}
.nav-links a{
  font-size:14.5px;font-weight:400;color:var(--muted);
  padding-bottom:4px;position:relative;transition:color .25s;
}
.nav-links a::after{
  content:'';position:absolute;bottom:0;inset-inline-start:0;width:0;height:1px;
  background:var(--gold);transition:width .3s ease;
}
.nav-links a:hover{color:var(--text)}
.nav-links a:hover::after{width:100%}
.nav-side{display:flex;align-items:center;gap:16px}
.lang{
  background:none;border:1px solid var(--hair);color:var(--muted);
  font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.2em;
  padding:8px 14px;cursor:pointer;transition:color .25s,border-color .25s;
}
.lang:hover{color:var(--gold);border-color:var(--gold)}

/* ---------- hero ---------- */
.hero{
  position:relative;min-height:100vh;min-height:100svh;
  display:flex;flex-direction:column;overflow:hidden;
}
.hero-media{position:absolute;inset:-14% 0 0 0;z-index:0}
.hero-media img{width:100%;height:114%;object-fit:cover;will-change:transform}
.hero-media::after{
  content:'';position:absolute;inset:0;
  background:
    linear-gradient(to top,var(--bg) 2%,rgba(13,24,38,.28) 34%,rgba(13,24,38,.5) 100%),
    linear-gradient(to left,rgba(13,24,38,.55),rgba(13,24,38,.05) 65%);
}
.hero-body{
  position:relative;z-index:2;flex:1;
  display:flex;flex-direction:column;justify-content:center;
  padding-top:120px;padding-bottom:60px;
}
.hero-title{
  font-family:'Amiri',serif;font-weight:700;
  font-size:clamp(46px,6.6vw,100px);
  line-height:1.32;letter-spacing:0;
  margin-bottom:10px;
}
.hero-title .gold{color:var(--gold)}
.hero-title .cream{color:var(--cream)}
.hero-sub{
  max-width:560px;color:var(--muted);font-size:clamp(15px,1.35vw,18.5px);
  margin:22px 0 40px;
}
.hero-cta{display:flex;flex-wrap:wrap;gap:18px}

/* telemetry */
.telemetry{
  position:relative;z-index:2;
  border-top:1px solid var(--hair);
  display:grid;grid-template-columns:repeat(5,1fr);
}
.tele-cell{
  padding:20px clamp(12px,2vw,28px) 24px;
  border-inline-start:1px solid var(--hair-soft);
}
.tele-cell:first-child{border-inline-start:none}
.tele-label{
  font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.3em;
  color:var(--faint);text-transform:uppercase;margin-bottom:6px;display:block;
}
.tele-value{font-family:'Marcellus',serif;font-size:clamp(15px,1.5vw,21px);color:var(--text);letter-spacing:.04em}
.tele-value .ar{font-family:'IBM Plex Sans Arabic',sans-serif;font-size:.72em;color:var(--muted)}
.tele-value.gold{color:var(--gold)}

/* rotating badge */
.badge{
  position:absolute;z-index:3;
  inset-inline-end:clamp(24px,5vw,72px);bottom:150px;
  width:168px;height:168px;
}
.badge .ring-chars{
  position:absolute;inset:0;pointer-events:none;
  animation:spin 18s linear infinite;
}
.badge .ring-chars span{
  position:absolute;top:50%;left:50%;
  font-family:'Marcellus',serif;font-size:10.5px;color:var(--gold);
  transform-origin:0 0;will-change:transform;
}
@keyframes spin{to{transform:rotate(-360deg)}}