/* scroll hint */
.scroll-hint{
  position:absolute;z-index:3;bottom:150px;inset-inline-start:clamp(24px,5vw,72px);
  display:flex;flex-direction:column;align-items:center;gap:10px;
  font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.34em;color:var(--faint);
  writing-mode:vertical-rl;
}
.scroll-hint::after{content:'';width:1px;height:56px;background:linear-gradient(var(--gold),transparent)}

/* ---------- sections ---------- */
section{position:relative}
.sec-pad{padding-block:clamp(90px,11vw,170px)}

/* manifesto */
.manifesto{text-align:center}
.manifesto .mark{
  font-family:'Amiri',serif;font-size:clamp(60px,7vw,110px);
  color:var(--gold);line-height:.4;display:block;margin-bottom:34px;
}
.manifesto h2{
  font-family:'Amiri',serif;font-weight:400;
  font-size:clamp(30px,4.4vw,62px);line-height:1.55;
  max-width:900px;margin-inline:auto;
}
.manifesto h2 .gold{color:var(--gold);font-weight:700}
.manifesto .note{
  margin:44px auto 0;max-width:640px;color:var(--muted);font-size:15.5px;
  padding-top:34px;border-top:1px solid var(--hair-soft);
}

/* features */
.feats-head h2{
  font-family:'Amiri',serif;font-weight:700;
  font-size:clamp(34px,4.6vw,64px);line-height:1.35;margin-bottom:18px;
}
.feats-head p{max-width:620px;color:var(--muted);font-size:16px}
.feats{position:relative;margin-top:clamp(50px,6vw,90px)}
.feats::before{
  content:'';position:absolute;top:14px;bottom:14px;inset-inline-start:64px;
  border-inline-start:1px dashed var(--hair);
}
.feat{
  position:relative;
  display:grid;grid-template-columns:128px 1fr 1fr;gap:clamp(24px,4vw,72px);
  padding-block:clamp(44px,5vw,68px);
  border-top:1px solid var(--hair-soft);
}
.feat:last-child{border-bottom:1px solid var(--hair-soft)}
.feat-num{
  position:relative;display:flex;flex-direction:column;gap:14px;align-items:flex-start;
}
.feat-num .n{
  font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,38px);color:var(--gold);
  letter-spacing:.06em;background:var(--bg);padding-inline-end:16px;position:relative;z-index:2;
}
.feat-num::after{
  content:'';position:absolute;top:16px;inset-inline-start:-1px;z-index:1;
  width:11px;height:11px;transform:rotate(45deg);
  background:var(--bg);border:1px solid var(--gold);
}
.tag{
  font-family:'IBM Plex Sans Arabic',sans-serif;font-size:12px;font-weight:500;letter-spacing:.04em;
  border:1px solid var(--hair);color:var(--gold);padding:6px 18px;white-space:nowrap;
}
.tag.off{color:var(--faint);border-color:rgba(245,240,230,.16)}
.feat-main h3{
  font-family:'Amiri',serif;font-weight:700;
  font-size:clamp(24px,2.6vw,36px);line-height:1.45;margin-bottom:14px;
}
.feat-main p{color:var(--muted);font-size:15.5px;max-width:460px}
.feat-points{list-style:none;display:flex;flex-direction:column;gap:13px;align-self:center}
.feat-points li{
  display:flex;align-items:baseline;gap:14px;
  font-size:14.5px;color:rgba(245,240,230,.78);font-weight:400;
}
.feat-points li::before{content:'';flex:none;width:22px;height:1px;background:var(--gold);transform:translateY(-5px)}
.feat-points li em{font-style:normal;color:var(--gold);font-family:'IBM Plex Mono',monospace;font-size:.85em}

/* why */
.why{background:var(--bg-2);border-block:1px solid var(--hair-soft)}
.why-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(48px,6vw,110px);align-items:center}
.why h2{
  font-family:'Amiri',serif;font-weight:700;
  font-size:clamp(32px,4.2vw,58px);line-height:1.4;margin-bottom:22px;
}
.why h2 .gold{color:var(--gold)}
.why p{color:var(--muted);max-width:520px}
.stats{margin-top:clamp(36px,4vw,56px);border-top:1px solid var(--hair)}
.stat{
  display:flex;align-items:baseline;justify-content:space-between;gap:20px;
  padding:17px 2px;border-bottom:1px solid var(--hair-soft);
}
.stat .k{font-size:14.5px;color:var(--muted)}
.stat .v{font-family:'Marcellus',serif;font-size:clamp(18px,1.9vw,26px);color:var(--text);letter-spacing:.05em}
.stat .v.gold{color:var(--gold)}
.stat .v .dot{color:var(--gold);font-size:.6em;vertical-align:middle;margin-inline-end:8px}
.why-media{position:relative}
.why-frame{
  position:relative;overflow:hidden;
  border:1px solid var(--hair);
}
.why-frame::after{
  content:'';position:absolute;inset:14px;border:1px solid var(--hair-soft);pointer-events:none;z-index:2;
}
.why-frame img{width:100%;height:auto;transform:scale(1.12);will-change:transform}
.why-cap{
  display:flex;justify-content:space-between;gap:14px;margin-top:16px;
  font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.26em;color:var(--faint);
  text-transform:uppercase;
}

/* download */
.download{text-align:center;overflow:hidden}
.download .coords{
  font-family:'Marcellus',serif;font-size:13px;letter-spacing:.5em;color:var(--gold);
  margin-bottom:30px;
}
.download h2{
  font-family:'Amiri',serif;font-weight:700;
  font-size:clamp(36px,5vw,72px);line-height:1.35;margin-bottom:18px;
}
.download p{color:var(--muted);max-width:520px;margin:0 auto 44px}
.download .hero-cta{justify-content:center}
.download .fineprint{
  margin-top:38px;display:flex;flex-direction:column;gap:8px;
  font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;color:var(--faint);
}
.download .fineprint .ar{font-family:'IBM Plex Sans Arabic',sans-serif;letter-spacing:.04em;font-size:12.5px}

/* footer */
footer{border-top:1px solid var(--hair);position:relative;overflow:hidden}
.foot-grid{
  display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;
  padding-block:clamp(50px,6vw,80px) clamp(30px,4vw,50px);
}
.foot-brand .brand .ar{font-size:38px}
.foot-brand p{color:var(--faint);font-size:13.5px;margin-top:12px;max-width:280px}
.foot-col h4{
  font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.3em;
  color:var(--gold);text-transform:uppercase;margin-bottom:18px;font-weight:500;
}
.foot-col a{display:block;color:var(--muted);font-size:14px;padding-block:5px;transition:color .25s}
.foot-col a:hover{color:var(--gold)}
.foot-bottom{
  display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;
  padding-block:22px;border-top:1px solid var(--hair-soft);
  font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;color:var(--faint);
}
.foot-water{
  position:absolute;bottom:-.32em;inset-inline-start:50%;transform:translateX(50%);
  font-family:'Amiri',serif;font-weight:700;font-size:clamp(160px,26vw,420px);
  color:rgba(175,145,95,.055);line-height:1;pointer-events:none;user-select:none;white-space:nowrap;
}

/* reveal */
[data-reveal]{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s cubic-bezier(.22,.8,.3,1)}
[data-reveal].in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  [data-reveal]{opacity:1;transform:none;transition:none}
  .badge .ring-chars{animation:none}
  html{scroll-behavior:auto}
}

/* responsive */
@media (max-width:1080px){
  .feat{grid-template-columns:110px 1fr}
  .feat-points{grid-column:2}
  .feats::before{inset-inline-start:54px}
}
@media (max-width:900px){
  .nav-links{display:none}
  .badge,.scroll-hint{display:none}
  .telemetry{grid-template-columns:repeat(3,1fr)}
  .tele-cell:nth-child(4){border-inline-start:none}
  .tele-cell:nth-child(n+4){border-top:1px solid var(--hair-soft)}
  .why-grid{grid-template-columns:1fr}
  .why-media{max-width:520px}
  .foot-grid{grid-template-columns:1fr 1fr}
}
@media (max-width:620px){
  .feat{grid-template-columns:1fr;gap:18px}
  .feat-num{flex-direction:row;align-items:center}
  .feats::before,.feat-num::after{display:none}
  .telemetry{grid-template-columns:repeat(2,1fr)}
  .tele-cell{border-inline-start:none!important}
  .tele-cell:nth-child(even){border-inline-start:1px solid var(--hair-soft)!important}
  .tele-cell:nth-child(n+3){border-top:1px solid var(--hair-soft)}
  .foot-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>